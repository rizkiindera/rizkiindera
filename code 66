// === KONFIGURASI THINGSPEAK ===
const channelID = "1234567"; // GANTI DENGAN CHANNEL ID ANDA
const readAPIKey = "";       // ISI JIKA CHANNEL PRIVATE, KOSONGKAN JIKA PUBLIC
// ===============================

let isFetching = false; // Mencegah spam klik tombol refresh

function ambilDataTanah() {
    // Jika sedang mengambil data, jangan lakukan apa-apa
    if (isFetching) return; 
    
    isFetching = true;
    
    // Ambil elemen HTML
    const statusUpdate = document.getElementById("status-update");
    const nilaiSoil = document.getElementById("nilai-soil");
    const progressBar = document.getElementById("progress-bar");
    const statusBadge = document.getElementById("status-badge");
    const iconRefresh = document.getElementById("icon-refresh");
    
    // Mulai animasi putar ikon & ubah teks status
    iconRefresh.classList.add("spin");
    statusUpdate.innerText = "Memperbarui data...";

    // Susun URL ThingSpeak
    let url = `https://api.thingspeak.com/channels/${channelID}/fields/1/last.json`;
    if (readAPIKey !== "") {
        url += `?api_key=${readAPIKey}`;
    }

    fetch(url)
        .then(response => {
            if (!response.ok) throw new Error("Gagal mengambil data");
            return response.json();
        })
        .then(data => {
            if (data && data.field1 != null) {
                let kelembaban = parseFloat(data.field1);
                
                // 1. Update Angka Text
                nilaiSoil.innerText = kelembaban.toFixed(1);
                
                // 2. Update Lebar Progress Bar
                progressBar.style.width = kelembaban + "%";
                
                // 3. Logika Warna & Status
                let warna = "";
                let teksStatus = "";

                if (kelembaban < 30) {
                    warna = "#e74c3c"; // Merah
                    teksStatus = "Kering 🏜️";
                } else if (kelembaban >= 30 && kelembaban <= 70) {
                    warna = "#27ae60"; // Hijau
                    teksStatus = "Ideal 🌱";
                } else {
                    warna = "#2980b9"; // Biru
                    teksStatus = "Sangat Basah 💧";
                }

                // Terapkan warna
                nilaiSoil.style.color = warna;
                progressBar.style.backgroundColor = warna;
                statusBadge.style.backgroundColor = warna;
                statusBadge.innerText = teksStatus;
                
                // Update teks jam terakhir
                let waktu = new Date().toLocaleTimeString('id-ID');
                statusUpdate.innerText = "Berhasil diperbarui pukul " + waktu;
            } else {
                statusUpdate.innerText = "Data di ThingSpeak kosong.";
            }
        })
        .catch(error => {
            console.error("Error:", error);
            nilaiSoil.innerText = "Err";
            statusBadge.innerText = "Koneksi Terputus";
            statusBadge.style.backgroundColor = "#95a5a6";
            statusUpdate.innerText = "Gagal mengambil data.";
        })
        .finally(() => {
            // Hentikan animasi putar pada ikon refresh setelah selesai
            setTimeout(() => {
                iconRefresh.classList.remove("spin");
                isFetching = false;
            }, 500); // Beri jeda sedikit agar putaran animasi terasa mulus
        });
}

// 1. Tambahkan event klik pada tombol refresh
document.getElementById("btn-refresh").addEventListener("click", ambilDataTanah);

// 2. Ambil data pertama kali saat web dibuka
ambilDataTanah();

// 3. Ambil data otomatis tiap 15 detik (meskipun tidak diklik)
setInterval(ambilDataTanah, 15000);


