// === KONFIGURASI THINGSPEAK ===
const channelID = "1234567"; // GANTI DENGAN CHANNEL ID ANDA
const readAPIKey = "";       // ISI JIKA CHANNEL PRIVATE, KOSONGKAN JIKA PUBLIC
// ===============================

let isFetching = false;
let soilChart; // Variabel untuk menyimpan data grafik

// Inisialisasi Grafik (Chart.js)
function inisialisasiGrafik() {
    const ctx = document.getElementById('soilChart').getContext('2d');
    soilChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [], // Jam data masuk
            datasets: [{
                label: 'Kelembaban (%)',
                data: [], // Nilai persen
                borderColor: '#27ae60',
                backgroundColor: 'rgba(39, 174, 96, 0.2)',
                borderWidth: 3,
                tension: 0.4, // Membuat garis melengkung halus
                fill: true,
                pointRadius: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, max: 100 },
                x: { ticks: { maxTicksLimit: 5 } }
            },
            plugins: { legend: { display: false } } // Sembunyikan legenda agar rapi
        }
    });
}

// Fungsi Mengambil Data & Memperbarui Tampilan + Grafik
function ambilDataTanah() {
    if (isFetching) return; 
    isFetching = true;
    
    const iconRefresh = document.getElementById("icon-refresh");
    const statusUpdate = document.getElementById("status-update");
    
    iconRefresh.classList.add("spin");
    statusUpdate.innerText = "Mengambil data terbaru...";

    // URL Mengambil 10 data terakhir untuk digambar di grafik
    let url = `https://api.thingspeak.com/channels/${channelID}/fields/1.json?results=10`;
    if (readAPIKey !== "") url += `&api_key=${readAPIKey}`;

    fetch(url)
        .then(res => {
            if (!res.ok) throw new Error("Gagal mengambil data");
            return res.json();
        })
        .then(data => {
            const feeds = data.feeds;
            if (feeds && feeds.length > 0) {
                // --- UPDATE KOTAK 1 (NILAI TERBARU) ---
                let dataTerakhir = feeds[feeds.length - 1]; // Ambil data paling ujung
                let kelembaban = parseFloat(dataTerakhir.field1);
                
                document.getElementById("nilai-soil").innerText = kelembaban.toFixed(1);
                document.getElementById("progress-bar").style.width = kelembaban + "%";
                
                let warna = "", teksStatus = "";
                if (kelembaban < 30) { warna = "#e74c3c"; teksStatus = "Kering 🏜️"; } 
                else if (kelembaban <= 70) { warna = "#27ae60"; teksStatus = "Ideal 🌱"; } 
                else { warna = "#2980b9"; teksStatus = "Basah 💧"; }

                document.getElementById("nilai-soil").style.color = warna;
                document.getElementById("progress-bar").style.backgroundColor = warna;
                const statusBadge = document.getElementById("status-badge");
                statusBadge.style.backgroundColor = warna;
                statusBadge.innerText = teksStatus;

                // --- UPDATE KOTAK 2 (GRAFIK) ---
                let labelWaktu = [];
                let nilaiGrafik = [];
                
                feeds.forEach(feed => {
                    if(feed.field1 != null) {
                        // Ubah waktu ThingSpeak ke format jam lokal (misal 14:05)
                        let waktuLokal = new Date(feed.created_at).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'});
                        labelWaktu.push(waktuLokal);
                        nilaiGrafik.push(parseFloat(feed.field1));
                    }
                });

                // Masukkan data ke grafik lalu update
                soilChart.data.labels = labelWaktu;
                soilChart.data.datasets[0].data = nilaiGrafik;
                soilChart.update();

                statusUpdate.innerText = "Terakhir diperbarui: " + new Date().toLocaleTimeString('id-ID');
            }
        })
        .catch(err => {
            console.error(err);
            statusUpdate.innerText = "Gagal mengambil data dari ThingSpeak.";
        })
        .finally(() => {
            setTimeout(() => { iconRefresh.classList.remove("spin"); isFetching = false; }, 500);
        });
}

// Fungsi untuk Mengirim Perintah ON/OFF Pompa ke Wemos
function kontrolPompa(id, state) {
    const statusUpdate = document.getElementById("status-update");
    let statusAlat = (state === 1) ? "menghidupkan" : "mematikan";
    statusUpdate.innerText = `Sedang ${statusAlat} pompa...`;

    // Memanggil endpoint Wemos (Pastikan HP dan Wemos di jaringan WiFi yang sama)
    fetch(`/actuator?id=${id}&state=${state}`)
        .then(response => {
            if (response.ok) {
                alert(`Pompa berhasil di${state === 1 ? 'hidupkan' : 'matikan'}!`);
                statusUpdate.innerText = `Pompa ${state === 1 ? 'HIDUP' : 'MATI'}.`;
            } else {
                alert("Gagal mengirim perintah! Cek koneksi Wemos.");
            }
        })
        .catch(error => {
            console.error("Error:", error);
            alert("Terjadi kesalahan. Pastikan HP/Laptop terhubung ke jaringan Wemos.");
            statusUpdate.innerText = "Gagal menghubungi alat.";
        });
}

// Jalankan saat web dibuka
inisialisasiGrafik();
ambilDataTanah();

// Auto-refresh data tiap 15 detik
setInterval(ambilDataTanah, 15000);

