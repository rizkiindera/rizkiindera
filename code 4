<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Smart Farming</title>
    <style>
        /* Desain tampilan website */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        h1 {
            color: #2c3e50;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        .card {
            background: #ffffff;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        iframe {
            width: 100%;
            height: 260px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }
        .btn {
            padding: 12px 24px;
            margin: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            color: white;
            transition: 0.3s;
        }
        .btn-on {
            background-color: #27ae60;
        }
        .btn-on:hover {
            background-color: #219150;
        }
        .btn-off {
            background-color: #e74c3c;
        }
        .btn-off:hover {
            background-color: #c0392b;
        }
        .info-text {
            font-size: 14px;
            color: #7f8c8d;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Dashboard Tanaman</h1>

        <!-- Bagian 1: Monitoring Kelembaban Tanah -->
        <div class="card">
            <h2>Kelembaban Tanah (Live)</h2>
            <p class="info-text">Data dikirim ke Field 1 ThingSpeak setiap 15 detik</p>
            
            <!-- PENTING: Ganti angka 1234567 di bawah ini dengan Channel ID ThingSpeak Anda -->
            <iframe src="https://thingspeak.com/channels/1234567/charts/1?bgcolor=%23ffffff&color=%2327ae60&dynamic=true&results=30&type=line&update=15"></iframe>
        </div>

        <!-- Bagian 2: Kontrol Pompa Air (Aktuator 1) -->
        <div class="card">
            <h2>Kendali Pompa Air</h2>
            <button class="btn btn-on" onclick="kontrolAktuator(1, 1)">Hidupkan Pompa</button>
            <button class="btn btn-off" onclick="kontrolAktuator(1, 0)">Matikan Pompa</button>
        </div>

        <!-- Bagian 3: Kontrol Kipas (Aktuator 2) -->
        <div class="card">
            <h2>Kendali Kipas</h2>
            <button class="btn btn-on" onclick="kontrolAktuator(2, 1)">Hidupkan Kipas</button>
            <button class="btn btn-off" onclick="kontrolAktuator(2, 0)">Matikan Kipas</button>
        </div>
    </div>

    <script>
        // Fungsi JavaScript untuk mengirim perintah ke Wemos
        function kontrolAktuator(id, state) {
            // Memanggil endpoint /actuator?id=...&state=... di kodingan C++
            fetch(`/actuator?id=${id}&state=${state}`)
                .then(response => {
                    if (response.ok) {
                        let namaAlat = (id === 1) ? "Pompa" : "Kipas";
                        let statusAlat = (state === 1) ? "MENYALA" : "MATI";
                        alert(namaAlat + " berhasil di-" + statusAlat + "!");
                    } else {
                        alert("Gagal mengirim perintah! Cek koneksi Wemos.");
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("Terjadi kesalahan. Pastikan Anda terhubung ke jaringan Wemos.");
                });
        }
    </script>
</body>
</html>



<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitor Kelembaban Tanah</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e9ecef;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background-color: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 350px;
            width: 100%;
        }
        h2 {
            color: #2c3e50;
            margin-top: 0;
            font-size: 24px;
        }
        .value {
            font-size: 65px;
            font-weight: bold;
            color: #27ae60;
            margin: 20px 0;
        }
        .status {
            font-size: 14px;
            color: #7f8c8d;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Kelembaban Tanah</h2>
        <!-- Tempat angka % akan ditampilkan -->
        <div class="value" id="nilai-soil">-- %</div>
        <!-- Tempat status update waktu akan ditampilkan -->
        <div class="status" id="status-update">Menunggu data...</div>
    </div>

    <!-- Memanggil file JavaScript -->
    <script src="script.js"></script>
</body>
</html>


// === GANTI DENGAN CHANNEL ID THINGSPEAK ANDA ===
const channelID = "1234567"; 
// ===============================================

function ambilDataTanah() {
    const statusElement = document.getElementById("status-update");
    
    // URL untuk mengambil 1 data terakhir dari Field 1 ThingSpeak
    const url = `https://api.thingspeak.com/channels/${channelID}/fields/1/last.json`;

    fetch(url)
        .then(response => {
            if (!response.ok) {
                throw new Error("Gagal mengambil data");
            }
            return response.json();
        })
        .then(data => {
            // Jika ada data yang masuk dari ThingSpeak
            if (data && data.field1 != null) {
                // Ambil nilai dan bulatkan jadi 1 angka di belakang koma
                let kelembaban = parseFloat(data.field1).toFixed(1);
                
                // Masukkan nilai ke HTML dan tambahkan simbol %
                document.getElementById("nilai-soil").innerText = kelembaban + " %";
                
                // Update teks jam terakhir data masuk
                let waktu = new Date().toLocaleTimeString('id-ID');
                statusElement.innerText = "Update terakhir: " + waktu;
            } else {
                statusElement.innerText = "Data ThingSpeak kosong.";
            }
        })
        .catch(error => {
            console.error("Error:", error);
            document.getElementById("nilai-soil").innerText = "Error";
            statusElement.innerText = "Gagal terhubung ke ThingSpeak.";
        });
}

// 1. Ambil data pertama kali saat website baru dibuka
ambilDataTanah();

// 2. Ambil data terus menerus secara otomatis setiap 15 detik (15000 ms)
setInterval(ambilDataTanah, 15000);

